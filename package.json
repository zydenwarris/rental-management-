{
  "name": "rental-management-api",
  "version": "0.1.0",
  "private": true,
  "description": "Landlord-focused rental management backend. API only; data access sits behind repository interfaces.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:all": "concurrently -n api,web -c cyan,green -k \"npm run dev\" \"npm --prefix web run dev\"",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jose": "^6.2.9",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.12",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
