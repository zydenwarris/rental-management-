# Copy to web/.env (gitignored) and fill in.
#
# Everything here is compiled into the browser bundle, so only ever put public
# values in this file. The publishable key is designed to be public — row level
# security is what protects the data, not the secrecy of this string. The
# `secret` / `service_role` key must never appear anywhere under web/.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Project Settings → API Keys → publishable (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
