# Copy to .env (gitignored) and fill in. The API reads these; nothing here is sent
# to the browser — the frontend has its own web/.env with only public values.

# --- Database -----------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Port 6543 (Supavisor, transaction mode), NOT 5432. The transaction pooler is what
# makes the per-request `set_config(..., true)` preamble safe, and it is why the
# postgres.js client sets `prepare: false`.
#
# Leave DATABASE_URL unset to run entirely on the in-memory repositories, exactly as
# the app behaves today. That fallback is what keeps every step of the migration
# shippable on its own.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Auth ---------------------------------------------------------------------
# Supabase → Project Settings → API → Project URL. Used to build the JWKS endpoint
# for local token verification, and as the expected `iss` claim.
#
# No key belongs here. Tokens are verified against the project's public JWKS, so the
# API never holds the service_role/secret key at all.
SUPABASE_URL=https://<project-ref>.supabase.co

# --- Seeding ------------------------------------------------------------------
# The auth user id (uuid) the demo portfolio is attached to on boot. Leave unset for
# an empty portfolio, which is the normal case.
#
# Sign up through the web UI once, then copy your id from Supabase → Authentication
# → Users. Deliberately manual: the alternative is the admin API, which would drag
# the service_role key into a script sitting next to application code.
SEED_LANDLORD_ID=

# --- Local only ---------------------------------------------------------------
PORT=4000
